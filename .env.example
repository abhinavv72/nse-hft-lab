NSE_HFT_HOST=0.0.0.0
NSE_HFT_PORT=8000
NSE_HFT_MAX_ORDER_QTY=500
NSE_HFT_MAX_POSITION_PER_SYMBOL=2500
NSE_HFT_MAX_DAILY_LOSS=50000
NSE_HFT_MAX_PRICE_DEVIATION_BPS=50
NSE_HFT_STALE_MARKET_MS=5000
NSE_HFT_KILL_SWITCH_ENABLED=false
# Keep these enabled for the public demo only if the data providers are available.
NSE_HFT_LIVE_PRICES_ENABLED=true
NSE_HFT_LIVE_NEWS_ENABLED=true
# Optional: Hugging Face fine-grained token with "Make calls to Inference Providers".
# Keep this secret in your host's environment settings; never commit it.
NSE_HFT_AI_HF_TOKEN=
NSE_HFT_AI_MODEL=ProsusAI/finbert
# Optional free IPO Guru key: enables live GMP, lot size, registrar, and richer subscription data.
# Request one at https://www.ipoguru.in/ipo-gmp-details-developer-api and add it only to local .env/Render.
NSE_HFT_IPO_GURU_API_KEY=
